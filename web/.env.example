# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.

# SMTP credentials used by src/app/api/contact/route.ts to email every
# contact-form submission to dxcabezasg@gmail.com (see src/lib/constants.ts).
#
# Fastest path: a Gmail App Password on dxcabezasg@gmail.com itself
# (Google Account → Security → 2-Step Verification → App passwords), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=dxcabezasg@gmail.com
#   SMTP_PASS=<the 16-character app password>
# Any other SMTP provider (Zoho, SES, Postmark, your host's mail server...)
# works the same way — just point these at it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dxcabezasg@gmail.com
SMTP_PASS=

# n8n integration is paused for now (see README) — the contact form emails
# directly instead. Kept here in case it's picked back up later.
# N8N_CONTACT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/contact-form
