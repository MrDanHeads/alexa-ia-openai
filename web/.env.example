# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real webhook URLs or secrets.

# n8n Webhook node URL that receives contact-form submissions
# (see src/app/api/contact/route.ts). In n8n: add a Webhook node,
# method POST, and paste its "Production URL" here.
N8N_CONTACT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/contact-form
