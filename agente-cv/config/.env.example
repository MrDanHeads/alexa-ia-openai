# Copia este archivo a .env (que ya está en .gitignore) y completa con tus valores reales.
# Nunca commitees el .env con la clave real.

# Clave de la API de OpenAI. Solo necesita permiso de uso del endpoint de Chat
# Completions — no requiere ningún scope de escritura ni acceso a otros recursos.
OPENAI_API_KEY=sk-...

# Modelo a usar. gpt-4o-mini es un buen default costo/calidad para este caso de uso.
OPENAI_MODEL=gpt-4o-mini
